---
import type { Props } from "./type";

const { size, padded, color, class: className, title } = Astro.props;
---

<svg
  class:list={[
    "icon",
    size && `icon-${size}`,
    color && `icon-${color}`,
    padded && "icon-padded",
    className,
  ]}
  aria-hidden={!title ? "true" : undefined}
  role={title ? "img" : undefined}
>
  {title && <title>{title}</title>}
  <use
    href="/bsi-svg/sprites.svg#it-external-link"
    xlink:href="/bsi-svg/sprites.svg#it-external-link"></use>
</svg>
