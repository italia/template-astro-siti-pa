---
import PageAdapter from "@components/cms-adapters/datocms/PageAdapter.astro";
import { LocalesQuery } from "@graphql/query/settings";
import Layout from "@layouts/Layout.astro";
import { executeQuery } from "@lib/datocms";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const {
    site: { locales },
  } = await executeQuery(LocalesQuery);
  return locales.map((lang) => ({
    params: {
      lang,
    },
  }));
}

const { lang } = Astro.params;
Astro.locals.lang = lang;

const response = await getCollection("homepage");

const homepage = response[0].data;
if (!homepage) return;

const content = homepage.allContentLocales?.find(
  (contentLocale) => contentLocale.locale === lang,
)?.value;

if (!content) return;

Astro.locals.recordId = homepage.id;
---

<!-- pageSeo={homepage.metaTags} -->
<Layout datePublished={homepage.publishedAt}>
  <PageAdapter content={content} />
</Layout>
