---
import { FullTextSearch } from "../../components/FullTextSearch";
import Welcome from "../../components/Welcome.astro";
import Layout from "../../layouts/Layout.astro";
import { executeQuery } from "../../lib/datocms";
import { LocalesQuery } from "../../utils/query";

export async function getStaticPaths() {
  const {
    site: { locales },
  } = await executeQuery(LocalesQuery);
  return locales.map((lang) => ({
    params: {
      lang,
    },
  }));
}

const { lang } = Astro.params;
const random = Math.round(Math.random() * 100);
---

<Layout locale={lang}>
  <Welcome cta=`Hello world static ${random}` />
  <div class="py-4 col-12 text-center">
    <h1 class="h1">Cerca</h1>
    <p class="lead h6">
      Trova risposte, informazioni e molto altro in un attimo
    </p>

    <FullTextSearch client:only="react" />
  </div>
</Layout>
