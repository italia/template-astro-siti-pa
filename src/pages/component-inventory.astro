---
import "../styles/global.scss";
import bsi from "bootstrap-italia/dist/js/bootstrap-italia.bundle.min.js?url";
import Button from "../components/atoms/Button.astro";
import Chips from "../components/atoms/Chips.astro";
import Accordion from "../components/atoms/Accordion.astro";
import Header from "../components/organisms/Header.astro";
import Footer from "../components/organisms/Footer.astro";
import CardInline from "../components/molecules/CardInline.astro";

if (import.meta.env.PROD) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const accordionItems = [
  {
    id: "1",
    header: "Elemento Accordion #1",
    body: "Vestibulum hendrerit ultrices nibh, sed pharetra lacus ultrices eget. Morbi et ipsum et sapien dapibus facilisis. Integer eget semper nibh. Proin enim nulla, egestas ac rutrum eget, ullamcorper nec turpis.",
  },
  {
    id: "2",
    header: "Elemento Accordion #2",
    body: "Vestibulum hendrerit ultrices nibh, sed pharetra lacus ultrices eget. Morbi et ipsum et sapien dapibus facilisis. Integer eget semper nibh. Proin enim nulla, egestas ac rutrum eget, ullamcorper nec turpis.",
  },
];
---

<div class="container-fluid p-5">
  <h1 class="mb-4">Component Inventory</h1>

  <h2 class="mb-4">Atoms</h2>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>Accordion</th>
        <th>Header filled</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="p-3"> Sfondo Light </td>
        <td class="p-3">
          <Accordion items={accordionItems} />
        </td>
      </tr>
    </tbody>
  </table>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>Buttons</th>
        <th>Primary</th>
        <th>Outline Primary</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="p-3">Sfondo Light</td>
        <td class="p-3"> <Button label="Cliccami" /></td>
        <td class="p-3">
          <Button label="Cliccami" variant="outline-primary" /></td
        >
      </tr>
      <tr>
        <td class="p-3">Sfondo Dark</td>
        <td class="bg-dark p-3"><Button label="Cliccami" /></td>
        <td class="bg-dark p-3"
          ><Button label="Cliccami" variant="outline-primary" /></td
        >
      </tr>
      <tr>
        <td class="p-3">Sfondo Primary</td>
        <td class="bg-primary p-3"></td>
        <td class="bg-primary p-3"
          ><Button label="Cliccami" variant="outline-white" /></td
        >
      </tr>
    </tbody>
  </table>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th>Chips</th>
        <th>Primary</th>
        <th>Standard</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="p-3">Sfondo Light</td>
        <td class="p-3"> <Chips label="Informazione" variant="primary" /></td>
        <td class="p-3"> <Chips label="Informazione" variant="standard" /></td>
      </tr>
    </tbody>
    <tr>
      <td class="p-3">Sfondo Dark</td>
      <td class="bg-dark p-3"> <Chips label="Informazione" /></td>
      <td class="bg-dark p-3">
        <Chips label="Informazione" variant="standard" /></td
      >
    </tr>
  </table>

  <h2 class="mb-4">Molecules</h2>
  <table class="table table-bordered">
    <thead>
      <tr>
        <th>Card Inline</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td> Con categoria </td>
        <td class="bg-primary p-3">
          <CardInline
            title="Titolo contenuto editoriale"
            description="Testo breve che riassume il contenuto della pagina di destinazione in massimo tre o quattro righe, senza troncamento."
            category="Categoria"
            imageUrl="https://placeholderimage.eu/api/city/800/600"
          />
        </td>

        <tr>
          <td> Senza categoria </td>
          <td class="bg-dark p-3">
            <CardInline
              title="Titolo contenuto editoriale"
              description="Testo breve che riassume il contenuto della pagina di destinazione in massimo tre o quattro righe, senza troncamento."
              imageUrl="https://placeholderimage.eu/api/city/800/600"
            />
          </td>
        </tr>
      </tr>
    </tbody>

    <h2 class="mb-4">Organisms</h2>
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>Header</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="p-3">
            <Header />
          </td>
        </tr>
      </tbody>
    </table>

    <!-- FOOTER da chiarire -->
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>Footer</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="p-3">
            <Footer />
          </td>
        </tr>
      </tbody>
    </table>
  </table>

  <script src={bsi}></script>
</div>
