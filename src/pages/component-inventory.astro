---
import "../styles/global.scss";
import bsi from "bootstrap-italia/dist/js/bootstrap-italia.bundle.min.js?url";
import Button from "../components/atoms/Button.astro";
import Chips from "../components/atoms/Chips.astro";
import Header from "../components/organisms/Header.astro";
import Footer from "../components/organisms/Footer.astro";
import { CardInline } from "../components/molecules/CardInline";
import { Hero } from "../components/organisms/Hero";
import { Breadcrumb } from "../components/molecules/Breadcrumb";
import { Tabs } from "../components/molecules/Tabs";
import { Accordion } from "../components/molecules/Accordion";
import { TextAndImage } from "../components/organisms/TextAndImage";
import { Sidebar } from "../components/organisms/Sidebar";

if (import.meta.env.PROD) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const accordionItems = [
  {
    id: "1",
    header: "Elemento Accordion #1",
    body: "Vestibulum hendrerit ultrices nibh, sed pharetra lacus ultrices eget. Morbi et ipsum et sapien dapibus facilisis. Integer eget semper nibh. Proin enim nulla, egestas ac rutrum eget, ullamcorper nec turpis.",
  },
  {
    id: "2",
    header: "Elemento Accordion #2",
    body: "Vestibulum hendrerit ultrices nibh, sed pharetra lacus ultrices eget. Morbi et ipsum et sapien dapibus facilisis. Integer eget semper nibh. Proin enim nulla, egestas ac rutrum eget, ullamcorper nec turpis.",
  },
];

const tabsItems = [
  {
    id: "1",
    label: "Tab #1",
    active: true,
    disabled: false,
  },
  {
    id: "2",
    label: "Tab #2",
    active: false,
    disabled: false,
  },
  {
    id: "3",
    label: "Tab #3",
    active: false,
    disabled: true,
  },
];

const breadcrumbItems = [
  {
    id: "1",
    label: "Tab #1",
    active: false,
    linkTo: "#",
  },
  {
    id: "2",
    label: "Tab #2",
    active: false,
    linkTo: "#",
  },
  {
    id: "3",
    label: "Tab #3",
    active: true,
    linkTo: "#",
  },
];
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <div class="container-fluid p-5">
        <h1 class="mb-4">Component Inventory</h1>

        <h2 class="mb-4">Atoms</h2>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th
                >Buttons <p>
                  <em>Button</em> for actions.<br />
                  <em>ButtonLink</em> for links.
                </p></th
              >
              <th>Primary Large</th>
              <th>Outline Primary Large</th>
              <th>Primary Small</th>
              <th>Outline Primary Small</th>
              <th>Primary Mini</th>
              <th>Outline Primary Mini</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3">Light background</td>
              <td class="p-3"><Button label="Cliccami" /></td>
              <td class="p-3"
                ><Button label="Cliccami" variant="outline-primary" /></td
              >
              <td class="p-3"> <Button size="small" label="Cliccami" /></td>
              <td class="p-3">
                <Button
                  size="small"
                  label="Cliccami"
                  variant="outline-primary"
                />
              </td>
              <td class="p-3"><Button size="mini" label="Cliccami" /></td>
              <td class="p-3">
                <Button
                  size="mini"
                  label="Cliccami"
                  variant="outline-primary"
                />
              </td>
            </tr>

            <tr>
              <td class="p-3">Dark background</td>
              <td class="bg-dark p-3"><Button label="Cliccami" /></td>
              <td class="bg-dark p-3"
                ><Button label="Cliccami" variant="outline-primary" /></td
              >
              <td class="bg-dark p-3"
                ><Button size="small" label="Cliccami" /></td
              >
              <td class="bg-dark p-3"
                ><Button
                  size="small"
                  label="Cliccami"
                  variant="outline-primary"
                /></td
              >
              <td class="bg-dark p-3"
                ><Button size="mini" label="Cliccami" /></td
              >
              <td class="bg-dark p-3"
                ><Button
                  size="mini"
                  label="Cliccami"
                  variant="outline-primary"
                /></td
              >
            </tr>

            <tr>
              <td class="p-3">Primary background</td>
              <td class="bg-primary p-3"></td>
              <td class="bg-primary p-3"
                ><Button label="Cliccami" variant="outline-white" /></td
              >
              <td class="bg-primary p-3"></td>
              <td class="bg-primary p-3"
                ><Button
                  size="small"
                  label="Cliccami"
                  variant="outline-white"
                /></td
              >
              <td class="bg-primary p-3"></td>
              <td class="bg-primary p-3"
                ><Button
                  size="mini"
                  label="Cliccami"
                  variant="outline-white"
                /></td
              >
            </tr>
          </tbody>
        </table>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Chips</th>
              <th>Primary</th>
              <th>Standard</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3">Light background</td>
              <td class="p-3">
                <Chips label="Informazione" variant="primary" /></td
              >
              <td class="p-3">
                <Chips label="Informazione" variant="standard" /></td
              >
            </tr>
          </tbody>
          <tr>
            <td class="p-3">Dark background</td>
            <td class="bg-dark p-3"> <Chips label="Informazione" /></td>
            <td class="bg-dark p-3">
              <Chips label="Informazione" variant="standard" /></td
            >
          </tr>
        </table>

        <h2 class="mb-4">Molecules</h2>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Accordion</th>
              <th>Header filled</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3"> Light background </td>
              <td class="p-3">
                <Accordion items={accordionItems} />
              </td>
            </tr>
          </tbody>
        </table>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Breadcrumb</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3"> Primary background </td>
              <td class="bg-primary p-3">
                <Breadcrumb items={breadcrumbItems} />
              </td>
            </tr>
          </tbody>
        </table>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Card Inline</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td> With category </td>
              <td class="bg-primary p-3">
                <CardInline
                  title="Titolo contenuto editoriale"
                  description="Testo breve che riassume il contenuto della pagina di destinazione in massimo tre o quattro righe, senza troncamento."
                  category="Categoria"
                  imageUrl="https://placeholderimage.eu/api/city/800/600"
                />
              </td>

              <tr>
                <td>Without category </td>
                <td class="bg-dark p-3">
                  <CardInline
                    title="Titolo contenuto editoriale"
                    description="Testo breve che riassume il contenuto della pagina di destinazione in massimo tre o quattro righe, senza troncamento."
                    imageUrl="https://placeholderimage.eu/api/city/800/600"
                  />
                </td>
              </tr>
            </tr>
          </tbody>
        </table>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Tabs</th>
              <th>Primary</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3">Primary background</td>
              <td class="bg-primary p-3"><Tabs items={tabsItems} /></td>
            </tr>
          </tbody>
        </table>

        <h2 class="mb-4">Organisms</h2>
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Header</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-0">
                <Header />
              </td>
            </tr>
          </tbody>
        </table>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Hero</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Default</td>
            </tr>
            <tr>
              <td class="p-0">
                <Hero
                  category="Titolo occhiello"
                  title="Titolo della sezione"
                  paragraph="Platea dictumst vestibulum rhoncus est pellentesque elit ullamcorper dignissim cras. Dictum sit amet justo donec enim diam vulputate ut. Eu nisl nunc mi ipsum faucibus."
                  imageUrl="https://animals.sandiegozoo.org/sites/default/files/2016-08/animals_hero_mountains.jpg"
                />
              </td>
            </tr>
            <tr>
              <td>Small</td>
            </tr>
            <tr>
              <td class="p-0">
                <Hero
                  title="Titolo della sezione"
                  paragraph="Platea dictumst vestibulum rhoncus est pellentesque elit ullamcorper dignissim cras. Dictum sit amet justo donec enim diam vulputate ut. Eu nisl nunc mi ipsum faucibus."
                  size="small"
                  imageUrl="https://animals.sandiegozoo.org/sites/default/files/2016-08/animals_hero_mountains.jpg"
                >
                  <Breadcrumb slot="category" items={breadcrumbItems} /></Hero
                >
              </td>
            </tr>

            <tr>
              <td>Extra Small</td>
            </tr>
            <tr>
              <td class="p-0">
                <Hero
                  title="Titolo della sezione"
                  paragraph="Platea dictumst vestibulum rhoncus est pellentesque elit ullamcorper dignissim cras. Dictum sit amet justo donec enim diam vulputate ut. Eu nisl nunc mi ipsum faucibus."
                  size="xsmall"
                  imageUrl="https://animals.sandiegozoo.org/sites/default/files/2016-08/animals_hero_mountains.jpg"
                >
                  <Breadcrumb slot="category" items={breadcrumbItems} /></Hero
                >
              </td>
            </tr>
          </tbody>
        </table>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Sidebar</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3">
                <Sidebar header="Usare il cloud" />
              </td>
            </tr>
          </tbody>
        </table>

        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Text And Image</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-0">
                <TextAndImage
                  title="Cos’è il cloud e perché è importante?"
                  text="Il cloud è alla base della modernizzazione della Pubblica Amministrazione. Permette di erogare servizi digitali più sicuri, scalabili e sostenibili, migliorando la gestione dei dati e semplificando il lavoro di enti e fornitori. "
                  imageUrl="https://placeholderimage.eu/api/city/800/600"
                  labelButton="Azione primaria"
                />
              </td>
            </tr>
          </tbody>
        </table>

        <!-- FOOTER da chiarire -->
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Footer</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3">
                <Footer />
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="m-4">Esempio</h2>
      <Hero
        category="Titolo occhiello"
        title="Titolo della sezione"
        paragraph="Platea dictumst vestibulum rhoncus est pellentesque elit ullamcorper dignissim cras. Dictum sit amet justo donec enim diam vulputate ut. Eu nisl nunc mi ipsum faucibus."
        imageUrl="https://animals.sandiegozoo.org/sites/default/files/2016-08/animals_hero_mountains.jpg"
      />
      <TextAndImage
        title="Titolo della sezione"
        text="Platea dictumst vestibulum rhoncus est pellentesque elit ullamcorper dignissim cras. Dictum sit amet justo donec enim diam vulputate ut. Eu nisl nunc mi ipsum faucibus."
        imageUrl="https://placeholderimage.eu/api/city/800/600"
        labelButton="Azione primaria"
      />
    </main>
  </body>
</html>
<script src={bsi}></script>
