---
import { Accordion } from "../../molecules/Accordion";
import type { AccordionProps } from "../../molecules/Accordion/types";

type Props = {
  title: string;
  accordion: AccordionProps;
};
const { title, accordion } = Astro.props;
---

<section>
  <div class="container py-80">
    <div class="row align-items-top">
      <div class="col-12">
        <h2 class="heading-2-lg pb-5">
          {title}
        </h2>
        <Accordion {...accordion} />
      </div>
    </div>
  </div>
</section>
