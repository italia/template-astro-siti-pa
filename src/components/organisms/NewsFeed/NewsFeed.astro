---
import { SplitContent } from "@components/layout/SplitContent";
import { CardEditorialInlineMini } from "@components/molecules/CardEditorialInlineMini";
import type { CardEditorialInlineMiniProps } from "@components/molecules/CardEditorialInlineMini/CardEditorialInlineMini.astro";
import { CardEditorialNews } from "@components/molecules/CardEditorialNews";
import type { CardEditorialNewsProps } from "@components/molecules/CardEditorialNews/types";
import { TabContent, Tabs } from "@components/molecules/Tabs";
import TextContainer from "@components/molecules/TextContainer/TextContainer.astro";

type NewsTab = {
  title: string;
  componentName: "CardEditorialNews";
  news: CardEditorialNewsProps[];
};

type StoryTab = {
  title: string;
  componentName: "CardEditorialInlineMini";
  news: CardEditorialInlineMiniProps[];
};

export type UpdateTabSectionTab = NewsTab | StoryTab;

type UpdateTabSectionProps = {
  id: string;
  title: string;
  paragraph: string;
  tabs: UpdateTabSectionTab[];
};

type Props = UpdateTabSectionProps;

const { id, title, paragraph, tabs = [] } = Astro.props;

const tabsItems = tabs.map((tab, index) => ({
  id: `tab-${id}-${index}`,
  label: tab.title,
  active: index === 0,
}));
---

<SplitContent leftColumns={5} background="primary" alignItems="top">
  <TextContainer
    slot="left"
    title={title}
    paragraph={paragraph}
    variant="primary"
  />
  <div class="row pt-5">
    <Tabs id={id} variant="dark" items={tabsItems}>
      {
        tabs.map((tab, index) => (
          <TabContent tab={tabsItems[index]}>
            <div
              class="it-carousel-wrapper it-carousel-landscape-abstract splide d-block d-lg-none"
              data-bs-carousel-splide
              data-splide='{"gap":".5rem", "breakpoints":{"768":{"gap":".5rem"}, "992":{"gap":".5rem"}}}'
            >
              <div class="splide__track ps-lg-3 pe-lg-3">
                <ul class="splide__list it-carousel-all">
                  {tab.componentName === "CardEditorialNews" &&
                    tab.news.map((n) => (
                      <li class="splide__slide">
                        <div class="it-single-slide-wrapper h-100 p-2">
                          <CardEditorialNews {...n} />
                        </div>
                      </li>
                    ))}

                  {tab.componentName === "CardEditorialInlineMini" &&
                    tab.news.map((n) => (
                      <li class="splide__slide">
                        <div class="it-single-slide-wrapper h-100 p-2">
                          <CardEditorialInlineMini {...n} />
                        </div>
                      </li>
                    ))}
                </ul>
              </div>
            </div>

            <div class="d-none d-lg-block">
              <ul class="it-card-list row pt-5" aria-label={tab.title}>
                {tab.componentName === "CardEditorialNews" &&
                  tab.news.map((n) => (
                    <li class="col-12 col-lg-4 mb-3">
                      <CardEditorialNews {...n} />
                    </li>
                  ))}

                {tab.componentName === "CardEditorialInlineMini" &&
                  tab.news.map((n) => (
                    <li class="col-12 col-lg-6 mb-3">
                      <CardEditorialInlineMini {...n} />
                    </li>
                  ))}
              </ul>
            </div>
          </TabContent>
        ))
      }
    </Tabs>
  </div>
</SplitContent>

<script>
  const refreshTabCarousels = () => {
    const carousels = document.querySelectorAll(".splide");
    carousels.forEach((carousel) => {
      // @ts-ignore - Se l'istanza è presente, facciamo refresh
      if (carousel.splide) {
        // @ts-ignore - Se l'istanza è presente, facciamo refresh
        carousel.splide.refresh();
      } else {
        window.dispatchEvent(new Event("resize"));
      }
    });
  };

  document.addEventListener("shown.bs.tab", refreshTabCarousels);
</script>
<style is:global>
  .splide__pagination__page.is-active {
    background-color: white !important;
  }
</style>
