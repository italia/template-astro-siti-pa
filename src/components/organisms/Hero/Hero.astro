---
import "./style.scss";
type Props = {
  title: string;
  paragraph: string;
  imageUrl: string;
  size?: "xsmall" | "small" | "default";
  category?: string;
};

const { title, paragraph, size, category, imageUrl } = Astro.props;
const sizeClass =
  size === "xsmall"
    ? "xsmall-size"
    : size === "small"
      ? "small-size"
      : "default-size";
---

<section class=`it-hero-wrapper it-primary ${sizeClass}`>
  <div class="img-responsive-wrapper">
    <div class="img-responsive">
      <div class="img-wrapper">
        <img
          src={imageUrl}
          title="titolo immagine"
          alt="descrizione immagine"
        />
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row">
      <div class="col-12">
        <!-- TODO verifica perchè sembra spostato rispetto agli altri contenuti ps-5 -->
        <div class="it-hero-text-wrapper">
          {category && <span class="it-category ">{category}</span>}
          <slot name="category" />
          <h1>{title}</h1>
          <p class="d-none d-lg-block font-sans-serif">{paragraph}</p>
        </div>
      </div>
    </div>
  </div>
</section>
