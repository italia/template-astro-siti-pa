---
import { SplitContent } from "@components/layout/SplitContent";
import { TabContent, Tabs } from "@components/molecules/Tabs";
import {
  mapNewsToCardEditorialNewsProps,
  mapStoryToCardEditorialInlineMiniProps,
  mapWebinarToCardEditorialNewsProps,
} from "@utils/mappers";
import { getCollection } from "astro:content";
import { PaginatedCollection } from "@components/react/PaginatedCollection/PaginatedCollection";

type PageNewsTab = {
  title: string;
  paragraph: string;
  filterTitle: string;
  labelForAll: string;
  newsPageTabType: string;
};

type UpdateTabSectionProps = {
  id: string;
  tabs: PageNewsTab[];
};

type Props = UpdateTabSectionProps;

const { id, tabs = [] } = Astro.props;
const { lang } = Astro.locals;

const tabsItems = tabs.map((tab, index) => ({
  id: `tab-${id}-${index}`,
  label: tab.title,
  active: index === 0,
}));

const news = await getCollection("news");
const stories = await getCollection("stories");
const webinars = await getCollection("webinars");

function isValidTabType(val: string): val is "news" | "story" | "webinar" {
  return val === "news" || val === "story" || val === "webinar";
}

function getItems(tab: PageNewsTab) {
  if (tab.newsPageTabType === "news") {
    return news.map((n) => mapNewsToCardEditorialNewsProps(n.data));
  }
  if (tab.newsPageTabType === "story") {
    return stories.map((s) =>
      mapStoryToCardEditorialInlineMiniProps(s.data, lang),
    );
  }
  if (tab.newsPageTabType === "webinar") {
    return webinars.map((w) =>
      mapWebinarToCardEditorialNewsProps(w.data, lang),
    );
  }
  return [];
}
---

<SplitContent leftColumns={5} alignItems="top">
  <div class="row pt-5">
    <Tabs id={id} items={tabsItems}>
      {
        tabs.map((tab, index) => (
          <TabContent tab={tabsItems[index]}>
            {isValidTabType(tab.newsPageTabType) && (
              <PaginatedCollection
                client:load
                items={getItems(tab)}
                perPage={10}
                title={tab.title}
                paragraph={tab.paragraph}
                filterTitle={tab.filterTitle}
                labelForAll={tab.labelForAll}
                newsPageTabType={tab.newsPageTabType}
              />
            )}
          </TabContent>
        ))
      }
    </Tabs>
  </div>
</SplitContent>
