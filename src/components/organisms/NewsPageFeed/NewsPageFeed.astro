---
import { Chip } from "@components/atoms/Chip";
import { SplitContent } from "@components/layout/SplitContent";
import type { CardEditorialNewsProps } from "@components/react/CardEditorialNews";
import { TabContent, Tabs } from "@components/molecules/Tabs";
import { TextContainer } from "@components/molecules/TextContainer";
import { mapNewsToCardEditorialNewsProps } from "@utils/mappers";
import { getCollection } from "astro:content";
import { PaginatedNews } from "@components/react/PaginatedNews/PaginatedNews";

// type NewsTab = {
//   title: string;
//   componentName: "CardEditorialNews";
//   news: CardEditorialNewsProps[];
// };

// type StoryTab = {
//   title: string;
//   componentName: "CardEditorialInlineMini";
//   news: CardEditorialInlineMiniProps[];
// };

type PageNewsTab = {
  title: string;
  paragraph: string;
  filterTitle: string;
  labelForAll: string;
  newsPageTabType: string;
};

type UpdateTabSectionProps = {
  id: string;
  tabs: PageNewsTab[];
};

type Props = UpdateTabSectionProps;

const { id, tabs = [] } = Astro.props;

const tabsItems = tabs.map((tab, index) => ({
  id: `tab-${id}-${index}`,
  label: tab.title,
  active: index === 0,
}));

const news = await getCollection("news");

const mappedNews: CardEditorialNewsProps[] = news.map((n) =>
  mapNewsToCardEditorialNewsProps(n.data),
);
---

<SplitContent leftColumns={5} alignItems="top">
  <div class="row pt-5">
    <Tabs id={id} items={tabsItems}>
      {
        tabs.map((tab, index) => (
          <TabContent tab={tabsItems[index]}>
            {tab.newsPageTabType === "news" && (
              <PaginatedNews
                client:load
                news={mappedNews}
                perPage={10}
                title={tab.title}
                paragraph={tab.paragraph}
                filterTitle={tab.filterTitle}
                labelForAll={tab.labelForAll}
              />
            )}
          </TabContent>
        ))
      }
    </Tabs>
  </div>
</SplitContent>
