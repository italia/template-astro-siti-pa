---
import "./style.scss";
type Props = {
  label: string;
  visuallyHidden: string;
  linkTo: string;
  disabled?: boolean;
  variant?: "primary" | "standard" | "outline-white";
};
const {
  label,
  visuallyHidden,
  linkTo,
  variant = "standard",
  disabled = false,
} = Astro.props;

const className =
  variant === "outline-white"
    ? "chip-outline-white"
    : variant === "primary"
      ? "chip-primary "
      : "";
const disabledClass = disabled ? "chip-disabled" : "";
const finalHref = disabled ? undefined : linkTo;
const ariaDisabled = disabled ? "true" : "false";
---

<a
  class=`chip chip-simple ${className} ${disabledClass}`
  href={finalHref}
  aria-disabled={ariaDisabled}
>
  <span class="visually-hidden">{visuallyHidden}</span>
  <span class="chip-label">{label}</span>
</a>
