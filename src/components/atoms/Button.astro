---
type Props = {
  label: string;
  variant?: "primary" | "outline-primary" | "outline-white";
};
const { label, variant } = Astro.props;

const outlineClass = `border border-2 text-white border-white`;
const className = `btn btn-${variant || "primary"} btn-lg ${variant === "outline-white" && outlineClass}`;
---

<style>
  .btn-outline-white:hover {
    background-color: hsla(0, 0%, 100%, 0.1);
  }
  .btn-outline-white:active {
    background-color: hsla(0, 0%, 100%, 0.25);
  }
</style>
<button type="button" class={className}>{label}</button>
