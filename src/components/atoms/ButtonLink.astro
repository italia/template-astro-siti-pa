---
type Props = {
  label: string;
  variant?: "primary" | "outline-primary" | "outline-white";
  size?: "mini" | "small" | "large";
};
const { label, variant, size } = Astro.props;

const outlineClass = `border border-2 text-white border-white`;
const sizeClass = `${size === "mini" ? "btn-xs" : size === "small" ? "btn-sm" : "btn-lg"}`;
const className = `btn btn-${variant || "primary"} ${sizeClass} ${variant === "outline-white" && outlineClass}`;
---

<a class={className}>{label}</a>
