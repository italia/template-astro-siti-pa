---
import { Icon } from "@components/atoms/Icon";
import type { IconListBlockFragmentType } from "@graphql/commonFragments";

type Props = {
  block: IconListBlockFragmentType;
};

const { block } = Astro.props;

const items = block.items?.items;
---

<p class="fw-semibold fs-6 text-uppercase">{block.title}</p>

<div class="it-list-wrapper">
  <ul class="it-list">
    {
      items?.map((item) => (
        <li class="mb-3">
          <div class={`list-item border-0`}>
            <Icon icon={item.icon.url} className="text-primary me-3" />
            <div class={`col-10 h6 fw-normal`}>{item.label}</div>
          </div>
        </li>
      ))
    }
  </ul>
</div>
