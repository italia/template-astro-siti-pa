---
import type { HeaderFragmentType } from "@graphql/sectionFragments";
import { createMenu } from "@utils/createMenuHelper";
import { Header } from "@components/organisms/Header";
import { executeQuery } from "@lib/datocms";
import { LocalesQuery } from "@utils/query";

type Props = HeaderFragmentType;

const { tagline, organization, siteName, navigationBar } = Astro.props;

const { lang } = Astro.locals;
const currentUrl = Astro.url.pathname;

const {
  site: { locales },
} = await executeQuery(LocalesQuery);

const menuItems = createMenu(navigationBar, currentUrl, lang);
---

<Header
  brandTagLine={organization}
  brandTitle={siteName}
  slimContent={tagline}
  menuItems={menuItems}
  locales={locales}
/>
