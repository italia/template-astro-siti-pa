---
import TabsItem from "./TabsItem.astro";
type Props = {
  items: {
    id: string;
    label: string;
    active?: boolean;
    disabled?: boolean;
  }[];
};
const { items } = Astro.props;
---

<ul class="nav nav-tabs bg-primary border-bottom-0">
  {
    items.map(({ id, label, active, disabled }) => (
      <TabsItem id={id} label={label} active={active} disabled={disabled} />
    ))
  }
</ul>
