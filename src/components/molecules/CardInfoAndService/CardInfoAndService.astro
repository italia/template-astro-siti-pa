---
import { Icon } from "@components/atoms/Icon";
import ItExternalLink from "static/assets/itExternalLink.astro";
import type { CardInfoAndServiceProps } from "./types";

type Props = CardInfoAndServiceProps;

const { title, description, icon, linkTo } = Astro.props;

const isExternal = linkTo?.startsWith("http");
---

<article
  class="it-card it-card-banner it-card-height-full rounded shadow-sm border"
>
  <div class="it-card-body">
    <h3 class="it-card-title">
      <a
        href={linkTo}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
      >
        {title}
      </a>
    </h3>
    <p class="it-card-text">
      {description}
    </p>
  </div>
  <div class="it-card-banner-icon-wrapper">
    {
      icon ? (
        <Icon icon={icon} className="text-primary icon-xl" />
      ) : (
        <ItExternalLink color="primary" size="xl" />
      )
    }
  </div>
</article>
