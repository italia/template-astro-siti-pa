---
import Chips from "../atoms/Chips.astro";

type Props = {
  title: string;
  description: string;
  category: string;
  imageUrl: string;
};
const { title, description, category, imageUrl } = Astro.props;
---

<article
  class="it-card it-card-inline it-card-inline-mini it-card-image rounded-4 overflow-hidden"
>
  <div class="it-card-inline-content">
    <h3 class="it-card-title">
      <a href="#">{title}</a>
    </h3>
    <div class="it-card-body">
      <p class="it-card-text">
        {description}
      </p>
    </div>
  </div>
  <footer class="it-card-related it-card-footer">
    <div class="it-card-taxonomy">
      <Chips label={category} />
    </div>
  </footer>
</article>
<div class="it-card-image-wrapper">
  <div class="ratio ratio-1x1">
    <figure class="figure img-full">
      <img
        src={imageUrl}
        alt="Breve descrizione immagine se ha senso nel contesto, marcare altrimenti come decorativa lasciando l'alt applicato ma vuoto."
      />
    </figure>
  </div>
</div>
