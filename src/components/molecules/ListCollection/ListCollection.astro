---
import { CardEditorialNews } from "@components/molecules/CardEditorialNews";
import { SectionContainer } from "@components/organisms/SectionContainer";
import type { ListCollectionProps } from "./types";

type Props = ListCollectionProps;

const { title, items } = Astro.props;
---

<SectionContainer className="lightgrey-bg-a3">
  <div class="row justify-content-between align-items-top">
    <div class="col-lg-8 col-12">
      <h2 class="pb-lg-5">
        {title}
      </h2>
    </div>

    <div class="d-none d-lg-block">
      <ul class="it-card-list row">
        {
          items.map((item) => (
            <li class="col-12 col-lg-4 mb-3">
              <CardEditorialNews {...item} />
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="it-carousel-wrapper it-carousel-landscape-abstract splide d-block d-lg-none"
      data-bs-carousel-splide
      data-splide='{"gap":".5rem", "breakpoints":{"768":{"gap":".5rem"}, "992":{"gap":".5rem"}}}'
    >
      <div class="splide__track ps-lg-3 pe-lg-3">
        <ul class="splide__list it-carousel-all">
          {
            items.map((item) => (
              <li class="splide__slide">
                <div class="it-single-slide-wrapper h-100 p-2">
                  <CardEditorialNews {...item} />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</SectionContainer>
