---
import PreviewBar from "@components/PreviewBar.astro";
import FooterAdapter from "@components/cms-adapters/datocms/FooterAdapter.astro";
import HeaderAdapter from "@components/cms-adapters/datocms/HeaderAdapter.astro";
import { LastUpdate } from "@components/molecules/LastUpdate";
import { Seo, type TitleMetaLinkTag } from "@datocms/astro";
import type {
  FooterFragmentType,
  HeaderFragmentType,
} from "@graphql/sectionFragments";
import { executeQuery } from "@lib/datocms";
import { isDraftModeEnabled } from "@lib/draftMode";
import {
  GlobalSettingsQuery,
  LayoutQuery,
  SiteMetaTagsQuery,
} from "@utils/query";
import {
  buildBreadcrumbJsonLd,
  buildCollectionJsonLd,
  buildCommonJsonLd,
  buildContentJsonLd,
  buildFaqJsonLd,
  getArticleSection,
  getChildListItems,
  getPageTitle,
  toSchemaLanguage,
  type JsonLdPageData,
} from "@utils/seoJsonLd";
import bsi from "bootstrap-italia/dist/js/bootstrap-italia.bundle.min.js?url";
import "../styles/global.scss";

type Props = {
  pageSeo?: TitleMetaLinkTag[];
  redirectUrl?: string;
  noIndex?: boolean;
  datePublished?: string;
  jsonLd?: JsonLdPageData;
};

const isPreview = isDraftModeEnabled(Astro.cookies);
const {
  pageSeo = [],
  redirectUrl,
  noIndex = false,
  datePublished,
  jsonLd,
} = Astro.props;

const { lang } = Astro.locals;

const siteUrl = Astro.site || process.env.SITE_URL || "";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const languageTag = toSchemaLanguage(lang || "it");
const recordId = Astro.locals.recordId;

const jsonLdScripts = (() => {
  const scripts: Array<Record<string, any>> = [buildCommonJsonLd(siteUrl)];

  if (!jsonLd) {
    return scripts;
  }

  const pageName = getPageTitle(recordId, lang, jsonLd.seo);
  const description = jsonLd.seo?.description;
  const imageUrl = jsonLd.seo?.image?.url || null;

  if (jsonLd.pageType === "collection") {
    const items = getChildListItems(recordId, lang, siteUrl);
    const collectionLd = buildCollectionJsonLd({
      canonicalUrl,
      siteUrl,
      inLanguage: languageTag,
      name: pageName,
      description,
      listItems: items,
    });
    if (collectionLd) scripts.push(collectionLd);
  }

  if (jsonLd.pageType === "content") {
    const contentLd = buildContentJsonLd({
      canonicalUrl,
      siteUrl,
      inLanguage: languageTag,
      name: pageName,
      description,
      articleType: jsonLd.articleType,
      articleSection: getArticleSection(recordId, lang),
      publishedAt: jsonLd.publishedAt || undefined,
      updatedAt: jsonLd.updatedAt || undefined,
      imageUrl,
    });
    scripts.push(contentLd);
  }

  const breadcrumb = buildBreadcrumbJsonLd({
    canonicalUrl,
    recordId,
    locale: lang,
    siteUrl,
  });
  if (breadcrumb) scripts.push(breadcrumb);

  if (jsonLd.faq?.length) {
    const faqLd = buildFaqJsonLd({ canonicalUrl, faq: jsonLd.faq });
    if (faqLd) scripts.push(faqLd);
  }

  return scripts;
})();

const serializedJsonLdScripts = jsonLdScripts.map((script) =>
  JSON.stringify(script),
);

const result = await executeQuery(SiteMetaTagsQuery, {
  includeDrafts: isPreview,
});

const { layout, homepage, search } = await executeQuery(LayoutQuery, {
  variables: { locale: lang },
  includeDrafts: isPreview,
});

const { globalSetting } = await executeQuery(GlobalSettingsQuery, {
  variables: { locale: lang },
  includeDrafts: isPreview,
});

if (!layout) return;

const headerLayout: HeaderFragmentType = {
  tagline: layout.tagline,
  organization: layout.organization,
  siteName: layout.siteName,
  mainNavigation: layout.mainNavigation,
  secondaryNavigation: layout.secondaryNavigation,
  locales: layout.locales,
  logoSelect: layout.logoSelect,
};

const footerLayout: FooterFragmentType = {
  heading: layout.heading,
  organizations: layout.organizations,
  topicTitle: layout.topicTitle,
  topicLink: layout.topicLink,
  utilityTitle: layout.utilityTitle,
  utility: layout.utility,
  smallPrint: layout.smallPrint,
};

const isShowingPreviewBar = isPreview && redirectUrl;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <Seo data={[...result.site.faviconMetaTags, ...pageSeo]} />
    {
      serializedJsonLdScripts.map((payload, index) => (
        <script
          type="application/ld+json"
          key={`jsonld-${index}`}
          set:html={payload}
        />
      ))
    }
    <link
      href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {isShowingPreviewBar && <PreviewBar redirectUrl={redirectUrl} />}
    <HeaderAdapter
      {...headerLayout}
      homeRecordId={homepage?.id}
      search={search || undefined}
    />
    <main>
      <slot />
    </main>
    {
      datePublished && globalSetting && (
        <LastUpdate
          label={globalSetting.lastUpdateLabel}
          date={datePublished}
        />
      )
    }
    <FooterAdapter {...footerLayout} />
  </body>
</html>
<script src={bsi}></script>
